    "from torch.utils.data import DataLoader\n",
    "\n",
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "\n",
    "BATCH_SIZE = 96\n",
    "EPOCHS_resnet = 10\n",
    "EPOCHS_resnext = 7\n",
    "\n",
    "models = []\n",
    "\n",
    "train_ds = CircleDataset(train_split_df, DATASET_DIR, train_tfms)\n",
    "val_ds = CircleDataset(val_split_df, DATASET_DIR, val_tfms)\n",
    "\n",
    "train_loader = DataLoader(\n",
    "    train_ds,\n",
    "    batch_size=BATCH_SIZE,\n",
    "    shuffle=True,\n",
    "    num_workers=2,\n",
    "    pin_memory=True,\n",
    "    drop_last=True\n",
    ")\n",
    "\n",
    "val_loader = DataLoader(\n",
    "    val_ds,\n",
    "    batch_size=BATCH_SIZE,\n",
    "    num_workers=2,\n",
    "    pin_memory=True\n",
    ")\n",
    "\n",
    "for model_name in [\"resnet\", \"resnext\"]:\n",
    "\n",
    "    print(f\"Training {model_name}\")\n",
    "\n",
    "    model = build_model(model_name).to(device)\n",
    "\n",
    "    optimizer = torch.optim.AdamW(\n",
    "        model.parameters(),\n",
    "        lr=3e-4,\n",
    "        weight_decay=1e-4\n",
    "    )\n",
    "\n",
    "    if model_name == \"resnet\":\n",
    "        EPOCHS = EPOCHS_resnet\n",
    "    else:\n",
    "        EPOCHS = EPOCHS_resnext\n",
    "\n",
    "    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(\n",
    "        optimizer,\n",
    "        T_max=EPOCHS\n",
    "    )\n",
    "\n",
    "    best_val_acc = 0.0\n",
    "\n",
    "    for epoch in range(EPOCHS):\n",
    "\n",
    "        train_loss = train_epoch(model, train_loader, optimizer, device)\n",
    "\n",
    "        val_acc = validate(model, val_loader, device)\n",
    "\n",
    "        print(f\"{model_name} Epoch {epoch} loss {train_loss:.4f} val_acc {val_acc:.4f}\")\n",
    "\n",
    "        if val_acc > best_val_acc:\n",
    "            best_val_acc = val_acc\n",
    "\n",
    "        scheduler.step()\n",
    "\n",
    "    print(f\"Best {model_name} val_acc: {best_val_acc:.4f}\")\n",
    "    models.append(model)\n"
   ]
